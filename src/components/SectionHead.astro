---
type Props = {
  index: number;
  id: string;
  title: string;
  kicker?: string;
};

const { index, id, title, kicker } = Astro.props;
const number = String(index).padStart(2, "0");
---

<header class="section-head">
  <span class="section-head__num" aria-hidden="true">{number}</span>
  <h2 id={`${id}-title`} class="section-head__title">{title}</h2>
  {kicker && <p class="section-head__kicker">{kicker}</p>}
  <slot />
</header>
